# Database Configuration
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/neverforget

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,app://android

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Application Settings
APP_NAME="Never Forget Claude API"
DEBUG=False

# Rate Limiting (optional - for Phase 7)
RATE_LIMIT_PER_MINUTE=100
